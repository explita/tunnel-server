{
  "name": "@explita/tunnel-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "tunnel-plugin db:push"
  },
  "dependencies": {
    "@explita/env-loader": "^0.2.0",
    "@explita/infra-protocol": "^0.1.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/websocket": "^11.3.1",
    "fastify": "^5.12.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
